    1:				;=========================================================
    2:				; AT89C51 Motor Controller Core (MIDE-51 / ASEM-51 safe)
    3:				; LCD: 8-bit, Data=P2, RS=P0.0, E=P0.2, RW=GND
    4:				; Keypad calculator 4x4:
    5:				;   Rows A-D -> P1.0..P1.3
    6:				;   Cols 1-4 -> P1.4..P1.7
    7:				; Motor driver L293D:
    8:				;   IN1=P3.0, IN2=P3.1, EN1(PWM)=P3.7
    9:				;
   10:				; Keys:
   11:				;   '+'  -> CW
   12:				;   '-'  -> CCW
   13:				;   'C'  -> clear digit entry
   14:				;   '='  -> apply speed (2 digits)
   15:				;   0..9 -> digits
   16:				;=========================================================
   17:
   18:		B	 80	LCD_RS      BIT P0.0
   19:		B	 82	LCD_E       BIT P0.2
   20:
   21:				;---------------- RAM ----------------
   22:		N	 30	DUTY        DATA 30H     ; 0..99
   23:		N	 31	DIR         DATA 31H     ; 0=STOP,1=CW,2=CCW
   24:		N	 32	KEYBUF      DATA 32H     ; last read key
   25:		N	 33	D1_ASC      DATA 33H     ; first digit ASCII or 0FFh
   26:		N	 34	D2_ASC      DATA 34H     ; second digit ASCII or 0FFh
   27:
   28:		N      0000	ORG 0000H
   29:	  0000	02 00 03	LJMP START
   30:
   31:				;=========================================================
   32:	  0003			START:
   33:	  0003	75 81 6F	    MOV SP,#6FH
   34:	  0006	75 90 FF	    MOV P1,#0FFH
   35:	  0009	75 80 FF	    MOV P0,#0FFH
   36:	  000C	75 A0 00	    MOV P2,#00H
   37:
   38:	  000F	C2 B0		    CLR P3.0
   39:	  0011	C2 B1		    CLR P3.1
   40:	  0013	C2 B7		    CLR P3.7
   41:
   42:	  0015	75 30 32	    MOV DUTY,#50
   43:	  0018	75 31 00	    MOV DIR,#00

